<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/_v2/styles/stylesheet-basic.uss?fileID=7433441132597879392&amp;guid=8afdb7f5daa0440e7a5f68fe24b929c8&amp;type=3#stylesheet-basic" />
    <ui:VisualElement name="box" style="flex-grow: 1;">
        <ui:VisualElement name="header" style="flex-grow: initial; flex-direction: row; align-items: center; align-self: auto; justify-content: center; padding-left: 5%; margin-right: 0; padding-top: 5%; padding-bottom: 20px; padding-right: 5%;">
            <ui:VisualElement name="headerActionAreaLeft" style="flex-grow: 1; flex-direction: row;">
                <ui:Button text="BACK" class="buttonNavbarSM" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 28px;" />
                <ui:VisualElement style="flex-grow: 1;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; align-items: center;">
                <ui:Label text="select a" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Early%20GameBoy.ttf?fileID=12800000&amp;guid=af2fe50b4a7fe4f8782a5b3812b2bf42&amp;type=3#Early GameBoy&quot;); padding-bottom: 0; margin-bottom: 0; margin-right: 2px; padding-right: 1px; font-size: 28px;" />
                <ui:Label text="COURSE" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Early%20GameBoy.ttf?fileID=12800000&amp;guid=af2fe50b4a7fe4f8782a5b3812b2bf42&amp;type=3#Early GameBoy&quot;); font-size: 64px; -unity-font-style: normal; padding-top: 0; margin-top: 0; -unity-text-align: upper-center;" />
            </ui:VisualElement>
            <ui:VisualElement name="headerActionAreaRight" style="flex-grow: 1; flex-direction: row-reverse;">
                <ui:Button text="CONTINUE" class="buttonNavbarSM" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 28px;" />
                <ui:VisualElement style="flex-grow: 1;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="body" style="flex-grow: 1;">
            <ui:ListView horizontal-scrolling="true" fixed-item-height="600" show-border="true" item-template="project://database/Assets/UI/_v2/molecules/CourseItemContainer.uxml?fileID=9197481963319205126&amp;guid=d069fb5220688406b80932a5245c829a&amp;type=3#CourseItemContainer" data-source="project://database/Assets/Resources/GameData/Courses/CurlingCourses.asset?fileID=11400000&amp;guid=a6115f3e2cce04a81b5df16311e9ecdc&amp;type=2#CurlingCourses" data-source-path="CurlingCourses" binding-source-selection-mode="AutoAssign" style="flex-direction: row; flex-grow: 1;" />
        </ui:VisualElement>
        <ui:VisualElement name="footer" style="flex-grow: initial; flex-direction: row; align-items: center; align-self: auto; justify-content: center; padding-left: 50px; margin-right: 0; padding-top: 20px; padding-bottom: 20px; padding-right: 50px;">
            <ui:VisualElement name="footerActionAreaLeft" style="flex-grow: 1; flex-direction: row;">
                <ui:Button text="BACK" class="buttonNavbarSM" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                <ui:VisualElement style="flex-grow: 1;" />
            </ui:VisualElement>
            <ui:VisualElement name="footerActionAreaRight" style="flex-grow: 1; flex-direction: row-reverse;">
                <ui:Button text="CONTINUE" class="buttonNavbarSM" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                <ui:VisualElement style="flex-grow: 1;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
